{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "auto-context-handover",
  "version": "0.1.0",
  "description": "Measured soft-limit handover plugin for OpenCode V2: warns, hard-gates, and rotates the agent-written handover into a fresh session.",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "tui.ts",
    "source",
    "aiderdesk",
    "amp",
    "cline",
    "codex",
    "copilot",
    "crush",
    "goose",
    "kilo",
    "pi",
    "plugin.json",
    "mcp.json",
    ".codex-plugin",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "cline": {
    "plugins": [
      {
        "paths": ["./cline/index.ts"],
        "capabilities": ["tools", "hooks"]
      }
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p source/tsconfig.json && tsc --noEmit -p hooks/tsconfig.json && tsc --noEmit -p codex/tsconfig.json && tsc --noEmit -p crush/tsconfig.json && tsc --noEmit -p goose/tsconfig.json && tsc --noEmit -p pi/tsconfig.json && tsc --noEmit -p copilot/tsconfig.json && tsc --noEmit -p aiderdesk/tsconfig.json && tsc --noEmit -p cline/tsconfig.json && tsc --noEmit -p amp/tsconfig.json && tsc --noEmit -p kilo/tsconfig.json",
    "test": "node --test \"source/**/*.test.ts\" \"hooks/**/*.test.ts\" \"codex/**/*.test.ts\" \"crush/**/*.test.ts\" \"goose/**/*.test.ts\" \"pi/**/*.test.ts\" \"copilot/**/*.test.ts\" \"aiderdesk/**/*.test.ts\" \"cline/**/*.test.ts\" \"amp/**/*.test.ts\" \"kilo/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode/ai": "2.1.4",
    "@opencode/schema": "2.1.4",
    "effect": "4.0.1",
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.4"
  },
  "devDependencies": {
    "@aiderdesk/extensions": "0.39.0",
    "@ampcode/plugin": "0.0.0-20261028101742-g93a0da1",
    "@cline/sdk": "0.2.0",
    "@github/copilot-sdk": "1.0.28",
    "@kilocode/plugin": "7.8.23",
    "@kilocode/sdk": "7.8.23",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@opencode/plugin": "2.1.4",
    "@types/node": "22.10.2",
    "typescript": "5.7.3",
    "zod": "4.6.7"
  }
}
