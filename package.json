{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "auto-context-handover",
  "version": "0.1.0",
  "description": "Measured soft-limit handover plugin for OpenCode V2: warns, hard-gates, and rotates the agent-written handover into a fresh session.",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "tui.ts",
    "source",
    "codex",
    "pi",
    "plugin.json",
    "mcp.json",
    ".codex-plugin",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p source/tsconfig.json && tsc --noEmit -p hooks/tsconfig.json && tsc --noEmit -p codex/tsconfig.json && tsc --noEmit -p pi/tsconfig.json",
    "test": "node --test \"source/**/*.test.ts\" \"hooks/**/*.test.ts\" \"codex/**/*.test.ts\" \"pi/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode/ai": "2.1.4",
    "@opencode/schema": "2.1.4",
    "effect": "4.0.1",
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.4"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@opencode/plugin": "2.1.4",
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  }
}
